# All three values are server-side configuration. Keep .env untracked, mode 0600.
# Password input via stdin to node server/password.mjs; only its salted hash goes here.
APP_PASSWORD_HASH=
APP_ORIGIN=https://svobodadlaseti.shop
FRONTEND_ORIGIN=https://taiwan.svobodadlaseti.shop
# Host-side published port: choose one unused on your VPS. Container always uses 8080.
TAIWAN_HOST_PORT=18080
# Set only after the reverse proxy overrides X-Real-IP.
TRUST_PROXY=0
SESSION_COOKIE_PATH=/taiwan/api
