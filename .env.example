# Server-side configuration. Keep .env untracked, mode 0600.
# Password input via stdin to node server/password.mjs; only its salted hash goes here.
APP_PASSWORD_HASH=
APP_ORIGIN=https://taiwan-api.example.net
FRONTEND_ORIGIN=https://idanpon.github.io
AUTH_MODE=bearer
# Public numeric Client ID from BotFather → Login Widget (RS256).
# No Bot Token or Client Secret is required for the browser SDK login.
TELEGRAM_CLIENT_ID=
# Host-side published port: choose one unused on your VPS. Container always uses 8080.
TAIWAN_HOST_PORT=18080
# Set only after the reverse proxy overrides X-Real-IP.
TRUST_PROXY=0
SESSION_COOKIE_PATH=/api
